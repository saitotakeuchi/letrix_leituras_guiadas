# WordSync Engine - API Keys Configuration
# Copy this file to .env and fill in your API keys

# OpenAI API Key (Required)
# Used for: Whisper transcription, GPT-4o validation
# Get yours at: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-...

# Google API Key (Recommended)
# Used for: Gemini 2.5 Flash prosody analysis
# Get yours at: https://makersuite.google.com/app/apikey
GOOGLE_API_KEY=AIza...

# Anthropic API Key (Optional)
# Used for: Claude text analysis fallback
# Get yours at: https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-...

# Configuration
# Override config.yaml settings via environment variables

# Default language for transcription (default: pt)
# WORDSYNC_LANGUAGE=pt

# Whisper model size (default: whisper-1 for API, base for local)
# WORDSYNC_WHISPER_MODEL=whisper-1

# Enable debug logging (default: false)
# WORDSYNC_DEBUG=false

# Use local Whisper instead of API (default: false)
# Requires: pip install wordsync[local]
# WORDSYNC_USE_LOCAL_WHISPER=false
